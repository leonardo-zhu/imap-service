# ── HTTP Server ────────────────────────────────────────────────────────────
# Port for internal control API (POST /mail/mark-read) & Pub/Sub push webhook (POST /gmail/pubsub)
HTTP_PORT=2525

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token for OpenClaw webhooks and internal control endpoints
OPENCLAW_WEBHOOK_URL=http://your-openclaw-server/api/webhook
OPENCLAW_HOOKS_TOKEN=your_secure_token_here

# Optional: Token for GCP Pub/Sub Push Webhook authentication
# Set in GCP Pub/Sub Push Endpoint URL: https://your-ddns-domain:2525/gmail/pubsub?token=your_pubsub_token
PUBSUB_PUSH_TOKEN=your_pubsub_token_here

# ── IMAP Accounts ───────────────────────────────────────────────────────────
# Multi-account mode: set IMAP_ACCOUNTS as a JSON array.
# IMAP_ACCOUNTS=[{"host":"imap.qq.com","port":993,"user":"you@qq.com","pass":"authcode","label":"qq"}]

IMAP_ACCOUNTS=[{"host":"imap.qq.com","port":993,"user":"you@qq.com","pass":"authcode","label":"qq"}]

# ── Gmail Accounts (GCP Pub/Sub Push Mode) ──────────────────────────────────
# GMAIL_ACCOUNTS=[{"user":"you@gmail.com","label":"gmail-personal","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN","topicName":"projects/YOUR_PROJECT/topics/YOUR_TOPIC"}]

# GMAIL_ACCOUNTS=[{"user":"you@gmail.com","label":"gmail-personal","clientId":"...","clientSecret":"...","refreshToken":"...","topicName":"projects/my-gcp-project/topics/gmail-topic"}]
